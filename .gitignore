# ============ Unity 项目专用 .gitignore ============
# 说明：以下都是 Unity 自动生成/缓存的大文件或临时文件，不应提交。
# 注意：Assets 下的 .meta 文件必须提交（它们保存 GUID，是 Unity 引用关系的关键）。

# Unity 自动生成的临时/缓存目录
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Cc]rashReports/

# 自动生成的 IDE 工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 崩溃报告等
sysinfo.txt
crashlytics-build.properties

# 打包产物
*.apk
*.aab
*.unitypackage
*.app

# IDE 配置
.vs/
.idea/
.vscode/
